{
  "manifest_version": 3,
  "name": "ELF//SHELL — Workspace AI",
  "version": "0.13.0",
  "description": "Ayarime Workspace AI: manual read-only Google, BYOK, Morning Coffee, and privacy-safe connection diagnostics.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "identity",
    "alarms"
  ],
  "background": {
    "scripts": [
      "shared/workspace.js",
      "shared/persona.js",
      "google/oauth.js",
      "google/read.js",
      "google/files.js",
      "briefing/engine.js",
      "google/session.js",
      "ai/providers.js",
      "ai/openai-complimentary.js",
      "diagnostics/connection.js",
      "ai/session.js",
      "updater/release.js",
      "updater/checker.js",
      "ai/openai-stream.js",
      "background.js"
    ]
  },
  "sidebar_action": {
    "default_title": "Ayarime — Workspace",
    "default_panel": "sidebar.html",
    "default_icon": "icons/mark.svg"
  },
  "action": {
    "default_title": "Ayarime — Bring up my workspace",
    "default_icon": "icons/mark.svg"
  },
  "icons": {
    "48": "icons/mark.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "workspace-ai@elf-shell.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "authenticationInfo",
          "personalCommunications",
          "websiteContent",
          "personallyIdentifyingInfo"
        ]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'self' https://api.github.com https://oauth2.googleapis.com https://www.googleapis.com https://tasks.googleapis.com https://docs.googleapis.com https://sheets.googleapis.com https://api.openai.com https://api.anthropic.com https://generativelanguage.googleapis.com"
  },
  "externally_connectable": {
    "ids": [
      "elf-shell-ayarime@local.theme"
    ]
  },
  "optional_host_permissions": [
    "https://oauth2.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://tasks.googleapis.com/*",
    "https://docs.googleapis.com/*",
    "https://sheets.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.github.com/*"
  ]
}
